FROM anaconda/miniconda:latest

ARG CONDA_DIR=/opt/miniconda3
ARG EPOCH
ARG DISTRO
ARG DISTRO_SUBDIR=released

ENV PATH=${CONDA_DIR}/envs/rachis-${DISTRO}-${EPOCH}/bin:$PATH
ENV LC_ALL=C.UTF-8
ENV LANG=C.UTF-8
ENV MPLBACKEND=agg
ENV UNIFRAC_USE_GPU=N

# Fails if the base image moves its conda prefix away from CONDA_DIR
RUN test "$(conda info --base)" = "${CONDA_DIR}"

# Accept ToS for miniconda end user license
# https://hub.docker.com/r/anaconda/miniconda#building-a-custom-image
ENV CONDA_PLUGINS_AUTO_ACCEPT_TOS=true
RUN conda update -q -y conda
RUN conda install -q -y wget
RUN apt-get update \
 && apt-get install -y --no-install-recommends procps \
 && rm -rf /var/lib/apt/lists/*

COPY ${EPOCH}/${DISTRO}/${DISTRO_SUBDIR}/rachis-${DISTRO}-linux-64-conda.yml released-env.yml
RUN conda env create -n rachis-${DISTRO}-${EPOCH} --file released-env.yml \
 && conda clean -a -y \
 && chmod -R a+rwx "${CONDA_DIR}" \
 && rm released-env.yml

ENV CONDA_PREFIX=${CONDA_DIR}/envs/rachis-${DISTRO}-${EPOCH}/
RUN qiime dev refresh-cache
RUN python -c "from qiime2.sdk.parallel_config import get_vendored_config; get_vendored_config()"
RUN echo "source activate rachis-${DISTRO}-${EPOCH}" >> /root/.bashrc
RUN echo "source tab-qiime" >> /root/.bashrc

# NOTE: Dont set GLIBC_TUNABLES=glibc.rtld.execstack=2 globally
# (prior addition from https://github.com/qiime2/distributions/pull/1108)
# It crashes Python 3.14 (conda's base env) under Rosetta on Apple silicon,
# which breaks bash, conda and activation. CI wont catch this (native amd64).
# Only the UniFrac GPU library (libssu_acc_nv.so) needs it; workaround for
# GPU users: can pass -e GLIBC_TUNABLES=glibc.rtld.execstack=2 at runtime

VOLUME ["/data"]
WORKDIR /data
